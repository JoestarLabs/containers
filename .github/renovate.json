{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Group all caddy-docker-cloudflare updates together",
      "matchFileNames": [
        "caddy-docker-cloudflare/**"
      ],
      "groupName": "Caddy Image Dependencies"
    },
    {
      "description": "Disable dependency updates for sunset plezy-relay",
      "matchFileNames": [
        "plezy-relay/**"
      ],
      "enabled": false
    },
    {
      "description": "Group all GitHub Actions workflow updates together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions Dependencies"
    }
  ]
}
